# Copia in .env.local e riempi con i valori stampati da `npx supabase start`.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Credenziali del progetto Google Cloud per l'accesso con Google (fase 1B).
# Senza queste due chiavi il pulsante "Continua con Google" resta visibile ma
# non completa il giro in locale: per provare l'accesso si usa l'SMS di test.
SUPABASE_AUTH_EXTERNAL_GOOGLE_CLIENT_ID=
SUPABASE_AUTH_EXTERNAL_GOOGLE_SECRET=
